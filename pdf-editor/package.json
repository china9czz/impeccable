{
  "name": "vellum-pdf-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Vellum PDF: a desktop PDF editor MVP built with Electron, React, TypeScript, pdf.js and pdf-lib.",
  "author": "Vellum PDF contributors",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "electron .",
    "make-sample": "node scripts/make-sample.mjs",
    "smoke-ops": "node scripts/smoke-ops.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:web": "node scripts/screenshot-web.mjs",
    "test:e2e": "node scripts/e2e-web.mjs",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.vellum.pdf",
    "productName": "Vellum PDF",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Vellum PDF"
    }
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "^0.24.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
